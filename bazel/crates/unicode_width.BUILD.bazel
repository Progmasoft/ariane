# The crate unicode_width from crates.io, as Cargo.lock pins it.

load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "unicode_width",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["**"], exclude = ["src/**/*.rs"]),
    crate_features = ["cjk"],
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_flags = ["--cap-lints=allow"],
    visibility = ["//visibility:public"],
    deps = [],
)
