# The crate ariadne from crates.io, as Cargo.lock pins it.

load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "ariadne",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["**"], exclude = ["src/**/*.rs"]),
    crate_features = [],
    crate_root = "src/lib.rs",
    edition = "2018",
    rustc_flags = ["--cap-lints=allow"],
    visibility = ["//visibility:public"],
    deps = ["@crate_unicode_width//:unicode_width", "@crate_yansi//:yansi"],
)
