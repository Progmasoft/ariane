module(name = "ariane", version = "0.1.0")

bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# rules_rust downloads rustc 1.99.1, its default; nothing else is needed.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2024")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The crates of Cargo.lock, in its versions and with its SHA-256, built by the
# files in bazel/crates without Cargo. //:crates_match_cargo_lock checks that
# the two agree.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "crate_ariadne",
    build_file = "//bazel/crates:ariadne.BUILD.bazel",
    sha256 = "8454c8a44ce2cb9cc7e7fae67fc6128465b343b92c6631e94beca3c8d1524ea5",
    strip_prefix = "ariadne-0.6.0",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/ariadne/ariadne-0.6.0.crate"],
)

http_archive(
    name = "crate_unicode_width",
    build_file = "//bazel/crates:unicode_width.BUILD.bazel",
    sha256 = "ca718471876992059f251e33aafc334346ada08042b7661dd1fe313a9bced557",
    strip_prefix = "unicode-width-0.2.3",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/unicode-width/unicode-width-0.2.3.crate"],
)

http_archive(
    name = "crate_yansi",
    build_file = "//bazel/crates:yansi.BUILD.bazel",
    sha256 = "cfe53a6657fd280eaa890a3bc59152892ffa3e30101319d168b781ed6529b049",
    strip_prefix = "yansi-1.0.1",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/yansi/yansi-1.0.1.crate"],
)
