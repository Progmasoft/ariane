#
# The reference of the C API: doxygen writes doxygen/html. Every warning
# fails the build, an undocumented declaration included.

PROJECT_NAME           = Ariane
PROJECT_BRIEF          = "The diagnostics of Ariadne through a C API"
OUTPUT_DIRECTORY       = doxygen
INPUT                  = README.md CODE_OF_CONDUCT.md PATENTS.md include/ariane
FILE_PATTERNS          = *.h *.md
USE_MDFILE_AS_MAINPAGE = README.md
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
# The reference has no graphs, so nothing needs Graphviz.
HAVE_DOT               = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = include
